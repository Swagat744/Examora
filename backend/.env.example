PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@examora.wl7ufr5.mongodb.net/examora?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Google Sign-In — the "Web client ID" from the same Google Cloud project
# backing your Firebase project (Firebase Console > Project Settings >
# General > Web SDK config, or Google Cloud Console > Credentials).
# This value is not secret (it's also used as-is in the frontend), but
# without it /api/auth/google will refuse every request.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Rate Limiting (Practical 5) ───────────────────────────────────────────────
# General API limiter — all /api/* routes.
# Default: 200 requests per 15 minutes per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Auth endpoint limiter — /api/auth/register, /login, /google.
# Stricter to mitigate brute-force / credential-stuffing attacks.
# Default: 20 requests per 15 minutes per IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
